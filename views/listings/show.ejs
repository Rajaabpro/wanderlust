<% layout("layouts/bolierplate.ejs") %>
<script>
  const mapToken = "<%= mapToken %>";
  const listingCoordinates = <%= JSON.stringify(listing.geometry.coordinates) %>;
  const listingTitle = "<%= listing.title %>";
</script>
<h3 class="mb-3"><%= listing.title %></h3>
<div class="card border-0">
  <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" class="listing-hero" alt="listing_image">
  <% if (listing.owner && listing.owner.avatar) { %>
    <img src="<%= listing.owner.avatar %>" class="avatar" alt="owner_avatar">
  <% } %>
  <div class="card-body p-3">
    <p class="card-text line-clamp-2"><%= listing.description %></p>
    <p class="mb-1"><span class="price">&#8377; <%= listing.price %></span> <span class="text-muted">/day</span></p>
    <p class="text-muted small mb-0"><%= listing.location %>, <%= listing.country %></p>
  </div>
</div>
<% if ( currentUser && listing.owner && currentUser._id.equals(listing.owner._id)) { %>
<div class="mt-3 d-flex align-items-center gap-2">
  <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
  <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
    <button class="btn btn-danger btn-sm" type="submit">Delete</button>
  </form>
</div>
<% } %>
<br>
  <div class="mt-3 mb-3">
    <h3>Where you'll be</h3>
    <div id="map"></div>
</div>
<section class="mt-4">
       <label for="starability-no-rate" title="No rating" style="font-weight:bold;">Leave a review </label>

  <form method="POST" action="/listings/<%= listing._id %>/reviews">
    <label for="rating">Rating</label>
    
    <fieldset class="starability-slot">
      <input type="radio" id="starability-no-rate" name="review[rating]" value="0" />
      
      <input type="radio" id="starability-1" name="review[rating]" value="1" />
      <label for="starability-1" title="Terrible">1 star</label>
      
      <input type="radio" id="starability-2" name="review[rating]" value="2" />
      <label for="starability-2" title="Not good">2 stars</label>
      
      <input type="radio" id="starability-3" name="review[rating]" value="3" />
      <label for="starability-3" title="Average">3 stars</label>
      
      <input type="radio" id="starability-4" name="review[rating]" value="4" />
      <label for="starability-4" title="Very good">4 stars</label>

      <input type="radio" id="starability-5" name="review[rating]" value="5" />
      <label for="starability-5" title="Excellent">5 stars</label>
    </fieldset>
    
    <div class="mt-2">
      <label for="comment">Comment</label>
      <textarea id="comment" name="review[comment]" class="form-control" rows="3"></textarea>
    </div>
    <button class="btn btn-primary btn-sm mt-2" type="submit">Submit</button>
  </form>
  <h4>Reviews</h4>
  <% for(let review of listing.reviews) { %>
    <div class="card mb-2 border-0 shadow-sm rounded-3 p-2 bg-light">
      <div class="card-body">
        <h5 class="card-title" style="font-weight:light;"><%= review.rating %> stars</h5>
        <div class="starability-result" data-rating="<%= review.rating %>"></div>
        <p class="card-text"><%= review.comment %></p>
        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
          <button class="btn btn-danger btn-sm" type="submit">Delete</button>
        </form>
      </div>
    </div>
  <% } %>

</section>

<script src="/js/map.js"></script>