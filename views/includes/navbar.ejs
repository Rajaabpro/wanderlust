<style>
  .search-input {
    border-radius: 1rem;
    height: 2rem;
    border: 1px solid #ccc;
    padding: 0.25rem 0.75rem;
    font-size: 1rem;
  }
  .search-input:focus {
    border-color: #ff385c;
    box-shadow: 0 0 0 0.2rem rgba(255, 56, 92, 0.25);
    outline: none;
  }
  .btn-search{
    background-color: #ff385c;
    color: #fff;
    border: none;
    border-radius: 1rem;
    height: 2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-search:hover{
    background-color: #e52a4c;
    color: #fff;
  }
</style>
<nav class="navbar navbar-expand-lg navbar-light bg-body-tertiary border-bottom sticky-top mb-3">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <i class="fa-brands fa-airbnb" style="color:#ff385c;font-size:1.5rem"></i>
      <span>WanderLust</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/listings">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/listings/new">Airbnb Your Home</a>
        </li>
      </ul>
      <div class="navbar-nav mx-auto">
        <form class="d-flex">
          <input class="search-input me-2" type="search" placeholder="Search destinations" aria-label="Search">
          <button class="btn btn-search" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>
        </form>
      </div>
      <ul class="navbar-nav">
        <% if (!currentUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/users/signup"><b>Sign Up</b></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/users/login"><b>Login</b></a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <span class="nav-link text-muted">Welcome, <%= currentUser.username %>!</span>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/users/logout">Logout</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>